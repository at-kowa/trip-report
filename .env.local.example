# このファイルを「.env.local」という名前でコピーし、supabase の開発用プロジェクトの値を入れる
# 値は supabase の管理画面「Project Settings → API Keys」（または「Connect」）で確認できる
# .env.local は共有しない（.gitignore で除外済み）。値をチャットやコードに書かない

# プロジェクトの URL（ブラウザに渡ってよい）
NEXT_PUBLIC_SUPABASE_URL=

# 公開用のキー（anon / publishable key。ブラウザに渡ってよい。データは RLS で守られる）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 管理者権限のキー（service_role / secret key）。サーバ側の処理だけで使う
# 名前に NEXT_PUBLIC_ を付けないこと（付けるとブラウザに渡ってしまう）
SUPABASE_SERVICE_ROLE_KEY=

# テスト用の利用者一覧をログイン画面に表示する（1 で表示。架空データだけの試作・研修の環境に限る。実データを扱う本番では設定しない）
SHOW_TEST_USERS=
